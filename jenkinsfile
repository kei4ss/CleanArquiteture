pipeline {
    agent any
    stages {

        stage('Building project') {
            steps {
                script {
                    configFileProvider([
                        configFile(
                            fileId: '62fc86a6-b785-4eec-8c8d-4e675d50b8a2', 
                            targetLocation: '.env',
                            variable: 'ENV_FILE'
                            )
                        ]
                    ){
                        sh 'echo "Checking .env..."'
                        sh 'test -f .env && echo ".env exists"'

                        sh 'docker build -t quote-app .'

                        sh 'echo "Checking .env inside image..."'
                        sh 'docker run --rm quote-app sh -c 'ls -la /app/.env''
                    }
                    
                }
            }
        }

        stage('Publish image in dockerHub registry') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerHub', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                        sh "docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD"
                        sh "docker tag quote-app $DOCKER_USERNAME/quote-app:latest"
                        sh "docker push $DOCKER_USERNAME/quote-app:latest"
                    }
                }
            }
        }

        stage('Deploy in local server'){
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerHub', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                        sh "docker rmi --force $DOCKER_USERNAME/quote-app:latest || true"
                        sh "docker pull $DOCKER_USERNAME/quote-app:latest"
                        sh "docker rm --force quote-app || true"
                        sh "docker run -d --name quote-app -p 8081:8081 $DOCKER_USERNAME/quote-app:latest"
                    }
                }
            }
        }
    }
}
